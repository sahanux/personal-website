// Cloudflare Workers config. The site is served as static assets from
// public/ — never the repo root, or node_modules gets uploaded too.
// Custom domains are declared here rather than clicked in the dashboard, so a
// later `wrangler deploy` from CI cannot drop them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sahankaru.online",
      "custom_domain": true
    },
    {
      "pattern": "www.sahankaru.online",
      "custom_domain": true
    }
  ],
  "main": "src/worker.js"
}
